# Both defaults are immutable OCI index digests mirrored in images.lock.json.
# The runtime can be replaced only with another digest from that lock file.
ARG GO_BUILDER_IMAGE=docker.io/library/golang@sha256:e8c859f5632dcfde7b32d2012b4351728f6437930887c2f6a91ea242459e5514
ARG RUNTIME_IMAGE=docker.io/library/ubuntu@sha256:513c074113a871b51a8d16ab445c88779d6452d937a164fb5cc479f32668a41d

# Each profile compiles its Wayland plugin against its own locked source root.
# All inputs below have already been fetched and are checked against repo locks.
FROM ${RUNTIME_IMAGE} AS runtime-root-build
ARG RUNTIME_PROFILE=gamescope
USER 0
COPY containers/multiseat/locks/${RUNTIME_PROFILE}.packages.json /locks/packages.json
COPY containers/multiseat/locks/rust.json /locks/rust.json
COPY containers/multiseat/locks/plugin.json /locks/plugin.json
COPY containers/multiseat/locks/gamescope.json /locks/gamescope.json
COPY containers/multiseat/verify-inputs.py /verify-inputs.py
COPY containers/multiseat/install-packages.sh /install-packages.sh
COPY containers/multiseat/verify-offline.sh /verify-offline.sh
COPY build/runtime-inputs/${RUNTIME_PROFILE}/build /inputs/packages
COPY build/runtime-inputs/${RUNTIME_PROFILE}/build.sha256 /inputs/checksums.sha256
COPY build/runtime-inputs/toolchains/rust-1.89.0-x86_64-unknown-linux-gnu.tar.xz /inputs/rust.tar.xz
COPY build/runtime-inputs/plugin.tar /inputs/plugin.tar
COPY build/runtime-inputs/gamescope.tar /inputs/gamescope.tar
RUN sh /install-packages.sh build && \
    mkdir -p /toolchain /src && \
    tar -xf /inputs/rust.tar.xz -C /toolchain --strip-components=1 && \
    /toolchain/install.sh --prefix=/opt/rust --components=rustc,cargo,rust-std-x86_64-unknown-linux-gnu --disable-ldconfig && \
    tar -xf /inputs/plugin.tar -C /src
ENV PATH=/opt/rust/bin:$PATH \
    CARGO_NET_OFFLINE=true \
    SOURCE_DATE_EPOCH=1754524800
WORKDIR /src
COPY containers/multiseat/patches /patches
RUN patch -d /src -p1 --batch --forward --fuzz=0 < /patches/display-polaris-model.patch && \
    cargo build --frozen --release -p gst-plugin-wayland-display && \
    test -f target/release/libgstwaylanddisplaysrc.so
COPY containers/multiseat/collect-plugin-notices.py /collect-plugin-notices.py
COPY containers/multiseat/licenses/display-dependencies /plugin-license-supplements
RUN python3 /collect-plugin-notices.py
RUN mkdir /gamescope-src && tar -xf /inputs/gamescope.tar -C /gamescope-src && \
    patch -d /gamescope-src -p1 --batch --forward --fuzz=0 < /patches/gamescope-ignore-unsupported-switches.patch && \
    patch -d /gamescope-src -p1 --batch --forward --fuzz=0 < /patches/gamescope-finish-command-buffers.patch && \
    meson setup /gamescope-src/build /gamescope-src --prefix=/usr --buildtype=release --wrap-mode=nodownload \
      -Ddefault_library=static -Denable_openvr_support=false -Denable_gamescope_wsi_layer=false \
      -Dpipewire=enabled -Ddrm_backend=enabled -Dsdl2_backend=disabled -Davif_screenshots=disabled \
      -Dinput_emulation=disabled -Dbenchmark=disabled -Drt_cap=disabled && \
    meson compile -C /gamescope-src/build -j 8 && \
    DESTDIR=/gamescope-root meson install -C /gamescope-src/build --no-rebuild

# Native acceptance workload uses the same pinned compiler and ABI closure.
FROM runtime-root-build AS workload-build
ARG RUNTIME_PROFILE=gamescope
COPY containers/multiseat/workloads/input-pong.c /workloads/input-pong.c
COPY containers/multiseat/providers /providers
# Steam uses both ELF ABIs. Both libraries pass the same real preload test.
RUN mkdir -p /out/steam-input && \
    if test "$RUNTIME_PROFILE" = steam; then \
      for abi in 64 32; do \
        triplet=x86_64-linux-gnu; if test "$abi" = 32; then triplet=i386-linux-gnu; fi; \
        directory=/out/steam-input/usr/lib/$triplet; mkdir -p "$directory"; \
        cc -m$abi -std=c11 -O2 -Wall -Wextra -Werror -fPIC -shared \
          -ffile-prefix-map=/providers=. -Wl,--build-id=none \
          /providers/steam-input.c -o "$directory/libpolaris-steam-input.so" -pthread -ldl \
          -Wl,--no-as-needed -l:libdl.so.2 -l:libpthread.so.0 -Wl,--as-needed && \
        cc -m$abi -std=c11 -O2 -Wall -Wextra -Werror \
          -ffile-prefix-map=/providers=. -Wl,--build-id=none \
          /providers/test-steam-input.c -o /out/test-steam-input-$abi -pthread && \
        cc -m$abi -std=c11 -O2 -Wall -Wextra -Werror -fPIC -shared \
          /providers/test-steam-evdev.c -o /out/test-steam-input-$abi.evdev.so -ldl && \
        python3 /providers/test-steam-input.py /out/test-steam-input-$abi \
          "$directory/libpolaris-steam-input.so" || exit 1; \
        chmod 0555 "$directory/libpolaris-steam-input.so"; \
      done; \
    fi

RUN mkdir -p /out && cc -std=c11 -O2 -Wall -Wextra -Werror \
      -ffile-prefix-map=/workloads=. -Wl,--build-id=none \
      /workloads/input-pong.c -o /out/input-pong-v1 \
      $(pkg-config --cflags --libs x11 gstreamer-1.0) -lm
RUN cc -std=c11 -O2 -Wall -Wextra -Werror -ffile-prefix-map=/providers=. -Wl,--build-id=none \
      /providers/test-seat-input.c /providers/seat-input.c -o /out/test-seat-input && /out/test-seat-input && \
    cc -std=c11 -O2 -Wall -Wextra -Werror -ffile-prefix-map=/providers=. -Wl,--build-id=none \
      /providers/test-pong-startup.c /workloads/input-pong.c -o /out/test-pong-startup \
      -Wl,--wrap=open -Wl,--wrap=XOpenDisplay $(pkg-config --cflags --libs x11 gstreamer-1.0) -lm && \
    POLARIS_DISPLAY_WIDTH=1280 POLARIS_DISPLAY_HEIGHT=720 PULSE_SINK=test PULSE_SERVER=test \
      POLARIS_PONG_TEST=absent /out/test-pong-startup && \
    for scenario in denied retired; do \
      result=0; POLARIS_DISPLAY_WIDTH=1280 POLARIS_DISPLAY_HEIGHT=720 PULSE_SINK=test PULSE_SERVER=test \
        POLARIS_PONG_TEST=$scenario /out/test-pong-startup || result=$?; test "$result" = 1 || exit 1; \
    done && \
    cc -std=c11 -O2 -Wall -Wextra -Werror -ffile-prefix-map=/providers=. -Wl,--build-id=none \
      /providers/capture-input.c /providers/seat-input.c -o /out/capture-input \
      $(pkg-config --cflags --libs gstreamer-1.0) && \
    cc -std=c11 -O2 -Wall -Wextra -Werror /providers/test-idle-capture.c \
      /providers/capture-input.c /providers/seat-input.c -o /out/test-idle-capture \
      -Wl,--wrap=fstat -Wl,--wrap=gst_pad_add_probe -Wl,--wrap=gst_pad_remove_probe -Wl,--wrap=gst_element_set_state -Wl,--wrap=poll \
      $(pkg-config --cflags --libs gstreamer-1.0) && \
    for scenario in stall recover retire; do \
      result=0; POLARIS_CAPTURE_TEST=$scenario timeout 8s /out/test-idle-capture 1280 720 -- \
        fakesrc is-live=true datarate=1 sizetype=fixed sizemax=1 ! identity name=display ! fakesink sync=true || result=$?; \
      expected=1; if test "$scenario" = recover; then expected=0; fi; \
      test "$result" = "$expected" || exit 1; \
    done

RUN cc -std=c11 -O2 -Wall -Wextra -Werror -ffile-prefix-map=/providers=. -Wl,--build-id=none \
      /providers/game-status.c -o /out/game-status $(pkg-config --cflags --libs x11)

RUN cc -std=c11 -O2 -Wall -Wextra -Werror -ffile-prefix-map=/providers=. -Wl,--build-id=none \
      /providers/encoded-audio-check.c -o /out/encoded-audio-check \
      $(pkg-config --cflags --libs gstreamer-app-1.0 gstreamer-audio-1.0) -lm && \
    /out/encoded-audio-check --self-test && \
    for scenario in silence wrong-tone; do \
      result=0; /out/encoded-audio-check --self-test-$scenario || result=$?; test "$result" = 1 || exit 1; \
    done && \
    cc -std=c11 -O2 -Wall -Wextra -Werror /providers/test-encoded-audio-check.c -o /out/test-encoded-audio-check \
      -Wl,--wrap=gst_element_set_state -Wl,--wrap=gst_object_unref -Wl,--wrap=gst_pad_remove_probe \
      -Wl,--wrap=g_mutex_clear -Wl,--wrap=gst_app_sink_try_pull_sample -Wl,--wrap=gst_pad_add_probe \
      $(pkg-config --cflags --libs gstreamer-app-1.0 gstreamer-audio-1.0) -lm && \
    timeout 40s /out/test-encoded-audio-check

RUN cc -std=c11 -O2 -Wall -Wextra -Werror -ffile-prefix-map=/providers=. -Wl,--build-id=none \
      /providers/test-encoded-gl-download.c -o /out/test-encoded-gl-download \
      $(pkg-config --cflags --libs gstreamer-1.0 gstreamer-app-1.0 gstreamer-video-1.0 gstreamer-gl-egl-1.0 egl gbm) && \
    timeout 15s /out/test-encoded-gl-download

RUN cc -std=c11 -O2 -Wall -Wextra -Werror -ffile-prefix-map=/providers=. -Wl,--build-id=none \
      /providers/encoded-game-check.c -o /out/encoded-game-check \
      $(pkg-config --cflags --libs gstreamer-1.0 gstreamer-app-1.0 gstreamer-video-1.0 gstreamer-gl-egl-1.0 egl gbm) && \
    /out/encoded-game-check --self-test && \
    /out/encoded-game-check --self-test-cursor && \
    for scenario in empty frozen frozen-cursor frozen-moving-cursor ambiguous; do \
      result=0; /out/encoded-game-check --self-test-$scenario || result=$?; test "$result" = 1 || exit 1; \
    done && \
    cc -std=c11 -O2 -Wall -Wextra -Werror -ffile-prefix-map=/providers=. -Wl,--build-id=none \
      /providers/test-encoded-game-check.c -o /out/test-encoded-game-check \
      -Wl,--wrap=gst_element_set_state -Wl,--wrap=gst_object_unref -Wl,--wrap=gst_pad_remove_probe \
      -Wl,--wrap=g_mutex_clear -Wl,--wrap=eglTerminate -Wl,--wrap=gbm_device_destroy -Wl,--wrap=gst_app_sink_try_pull_sample -Wl,--wrap=gst_parse_launch \
      $(pkg-config --cflags --libs gstreamer-1.0 gstreamer-app-1.0 gstreamer-video-1.0 gstreamer-gl-egl-1.0 egl gbm) && \
    timeout 40s /out/test-encoded-game-check

RUN cc -std=c11 -O2 -Wall -Wextra -Werror /providers/test-encoder-sockets.c -o /out/test-encoder-sockets && /out/test-encoder-sockets
RUN cc -std=c11 -O2 -Wall -Wextra -Werror /providers/test-encoder-gpu.c -o /out/test-encoder-gpu \
      $(pkg-config --cflags --libs gstreamer-1.0 libdrm) -ldl && /out/test-encoder-gpu

RUN cc -std=c11 -O2 -Wall -Wextra -Werror -ffile-prefix-map=/providers=. -Wl,--build-id=none \
      /providers/encode-media.c -o /out/encode-media \
      $(pkg-config --cflags --libs gstreamer-app-1.0 gstreamer-video-1.0 gstreamer-gl-egl-1.0 egl gbm libdrm) -ldl && \
    python3 /providers/test-encode-media.py /out/encode-media

