policy_module(polaris_nvidia_worker, 1.1.0)

gen_require(`
    type container_file_t;
    type bin_t;
    type lib_t;
    type textrel_shlib_t;
    type usr_t;
    type xserver_misc_device_t;
    type polaris_multiseat_input_device_t;
    type unreserved_port_t;
    attribute port_type;
')

# Opt-in physical worker domain. Preserve the reference policy's container
# lifecycle and MCS constraints; never widen the generic container_t domain.
container_domain_template(polaris_nvidia_worker, container)

# The container template supplies sockets but not outbound TCP port access.
# Steam downloads and game servers use the profile's admitted Docker bridge.
# Steam also explicitly binds ephemeral client sockets before connecting.
# Permit generic addresses within the private network namespace. Keep the
# broader container network attribute's raw socket and administration grants off.
corenet_tcp_connect_all_ports(polaris_nvidia_worker_t)
corenet_tcp_bind_generic_node(polaris_nvidia_worker_t)
corenet_udp_bind_generic_node(polaris_nvidia_worker_t)
# Chromium's UDP random-bind path chooses its own port, including ports outside
# the kernel's ephemeral range. Steam's Chrome_ChildIOT needs name_bind there.
# Steam's local IPC engine also explicitly binds unreserved TCP listeners.
# Both remain inside the worker's private bridge with no published ports.
allow polaris_nvidia_worker_t unreserved_port_t:tcp_socket name_bind;
# Random UDP choices can carry service labels, including types shared between
# reserved and unreserved numbers. Port labels cannot express a numeric floor.
# Admit UDP binding within this private namespace, including Chromium mDNS,
# without the net_bind_service capability added by the all-ports interface.
allow polaris_nvidia_worker_t port_type:udp_socket name_bind;
# Steam's process helpers communicate through ephemeral TCP listeners too.
# They remain inside the private bridge with no published worker ports.
allow polaris_nvidia_worker_t self:tcp_socket { listen accept };

# Bubblewrap remounts files read only in its new user namespace's tmpfs.
# The outer worker drops all capabilities; this does not grant host mount authority.
fs_remount_tmpfs(polaris_nvidia_worker_t)

# Wine relocates DLLs in private writable file mappings before making their
# code executable. The container template permits execution but not execmod.
# Limit this permission to container files in this worker domain; retain MCS
# constraints, noexec mounts, and the existing device and capability limits.
allow polaris_nvidia_worker_t container_file_t:file execmod;

# Device admission still comes exclusively from the exact GPU catalog. This
# standard container template retains file-management permissions; dropped Linux
# capabilities and the mount classifier must constrain those permissions.
allow polaris_nvidia_worker_t xserver_misc_device_t:chr_file { getattr open read write ioctl map };
allow polaris_nvidia_worker_t polaris_multiseat_input_device_t:chr_file { getattr open read ioctl };
allowxperm polaris_nvidia_worker_t polaris_multiseat_input_device_t:chr_file ioctl { 0x4501 0x4506 0x4507 };

# A runtime built without driver libraries of its own reads this machine's NVIDIA
# userspace through read-only binds at the paths the loader resolves them by.
# Those files keep their own labels: relabelling the host's /usr to a container
# type would damage the host, so the read is granted here instead. Read and map
# only, on files Polaris itself enumerated and the mount classifier verified;
# no write, no relabel, no execution of host programs.
allow polaris_nvidia_worker_t lib_t:file { getattr open read map execute };
allow polaris_nvidia_worker_t textrel_shlib_t:file { getattr open read map execute execmod };
allow polaris_nvidia_worker_t usr_t:file { getattr open read map };

# Podman's --init binds only the mount-classifier-approved host catatonit.
# Initial entry into this domain also requires entrypoint on that bin_t file.
# Do not add this domain to broad sandbox execution attributes.
allow polaris_nvidia_worker_t bin_t:file { getattr open read map execute execute_no_trans entrypoint };
