+void CVulkanDevice::finishCommandBuffers()
+{
+	// Retire GPU work and its references before backend cleanup and process-exit
+	// destructors can invalidate dynamically loaded Vulkan dispatch code.
+	if (!m_bInitialized)
+		return;
+	waitIdle(false);
+	m_pendingCmdBufs.clear();
+	m_unusedCmdBufs.clear();
+}
+
+void vulkan_finish()
+{
+	g_device.finishCommandBuffers();
+
+	// Output images also own Vulkan objects. Release overlays before their base
+	// images, and retire every retained texture while the backend is still alive.
+	g_output.outputImagesPartialOverlay.clear();
+	g_output.outputImages.clear();
+	g_output.temporaryHackyBlankImage = nullptr;
+	for (auto &image : g_output.pScreenshotImages)
+		image = nullptr;
+	g_output.tmpOutput = nullptr;
+	g_output.nisScalerImage = nullptr;
+	g_output.nisUsmImage = nullptr;
+	g_output.swapchainHDRMetadata = nullptr;
+}
+
