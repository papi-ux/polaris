#!/usr/bin/env bash
# Seed config and exec polaris (generated by 03-install-gamescope-stack.sh).
set -euo pipefail
# shellcheck source=scripts/install/lib/polaris-seed-config.sh
. "$(dirname "${BASH_SOURCE[0]}")/polaris-seed-config.sh"
confdir="${XDG_CONFIG_HOME:-$HOME/.config}/polaris"
mkdir -p "$confdir"
if [ ! -e "$confdir/polaris.conf" ] && [ ! -L "$confdir/polaris.conf" ]; then
  if [ -e @CONF_SEED@ ] || [ -L @CONF_SEED@ ]; then
    polaris_seed_config "$confdir/polaris.conf" @CONF_SEED@
  else
    polaris_seed_config "$confdir/polaris.conf" <<'EOF'
headless_mode = enabled
linux_use_cage_compositor = enabled
linux_prefer_gpu_native_capture = disabled
linux_stream_mode = gamescope_stream
capture = portal
encoder = nvenc
hevc_mode = 3
av1_mode = 0
stream_audio = enabled
enable_pairing = enabled
enable_discovery = enabled
max_sessions = 2
EOF
  fi
fi
exec @POLARIS_BIN@
