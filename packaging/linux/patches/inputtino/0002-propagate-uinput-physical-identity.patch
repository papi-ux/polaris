@@ -12,6 +15,35 @@
 
 using libevdev_uinput_ptr = std::shared_ptr<libevdev_uinput>;
 using libevdev_event_ptr = std::shared_ptr<input_event>;
+
+// Preserve the requested physical identity on the descriptor used for creation.
+// Empty identities retain libevdev's existing managed-descriptor behavior.
+static Result<libevdev_uinput_ptr> create_uinput_device(libevdev *dev, const std::string &phys) {
+  if (phys.find('\0') != std::string::npos) {
+    return Error("Physical identity contains a null byte");
+  }
+  struct PendingFd {
+    int fd = -1;
+    ~PendingFd() { if (fd >= 0) close(fd); }
+  } pending;
+  int fd = LIBEVDEV_UINPUT_OPEN_MANAGED;
+  if (!phys.empty()) {
+    pending.fd = open("/dev/uinput", O_RDWR | O_NONBLOCK | O_CLOEXEC);
+    if (pending.fd < 0) return Error(strerror(errno));
+    fd = pending.fd;
+    if (ioctl(fd, UI_SET_PHYS, phys.c_str()) < 0) return Error(strerror(errno));
+  }
+  libevdev_uinput *device = nullptr;
+  auto error = libevdev_uinput_create_from_device(dev, fd, &device);
+  if (error != 0) return Error(strerror(-error));
+  // shared_ptr invokes this deleter even if its control-block allocation fails.
+  pending.fd = -1;
+  return libevdev_uinput_ptr{device, [fd](libevdev_uinput *value) {
+    libevdev_uinput_destroy(value);
+    if (fd >= 0) close(fd);
+  }};
+}
