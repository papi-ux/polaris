+static uint8_t modifier_for(short code) {
+  switch (code) {
+    case 0x10: case 0xA0: case 0xA1: return Keyboard::SHIFT;
+    case 0x11: case 0xA2: case 0xA3: return Keyboard::CTRL;
+    case 0x12: case 0xA4: case 0xA5: return Keyboard::ALT;
+    case 0x5B: case 0x5C: return Keyboard::META;
+    default: return 0;
+  }
+}
+
+static uint8_t missing_modifiers(const KeyboardState &state, uint8_t requested) {
+  for (const auto &key : state.cur_press_keys) requested &= ~modifier_for(key.code);
+  return requested & (Keyboard::SHIFT | Keyboard::CTRL | Keyboard::ALT | Keyboard::META);
+}
+
+static void release_btn(libevdev_uinput *kb, short code) {
+  const auto found = keyboard::key_mappings.find(code);
+  if (found == keyboard::key_mappings.end()) return;
+  libevdev_uinput_write_event(kb, EV_MSC, MSC_SCAN, found->second.scan_code);
+  libevdev_uinput_write_event(kb, EV_KEY, found->second.linux_code, 0);
+  libevdev_uinput_write_event(kb, EV_SYN, SYN_REPORT, 0);
+}
+
+static void press_with_modifiers(KeyboardState &state, const KeyboardPress &key) {
+  // Recheck physical keys for every repeat: a left/right modifier may have been
+  // pressed since this chord started. Temporary modifiers never become held keys.
+  const auto modifiers = missing_modifiers(state, key.synthetic_modifiers);
+  static constexpr std::array<std::pair<uint8_t, short>, 4> keys{{
+      {Keyboard::SHIFT, 0xA0}, {Keyboard::CTRL, 0xA2},
+      {Keyboard::ALT, 0xA4}, {Keyboard::META, 0x5B}}};
+  auto *kb = state.kb.get();
+  for (const auto &[flag, code] : keys) if (modifiers & flag) press_btn(kb, code);
+  press_btn(kb, key.code);
+  // Attempt every release even if a kernel write returned an error. This is
+  // the library's existing best-effort write contract, not an acknowledgement.
+  for (auto it = keys.rbegin(); it != keys.rend(); ++it) {
+    if (modifiers & it->first) release_btn(kb, it->second);
+  }
+}
+
