print_host_setup_hint() {
  cat <<'EOF'
Polaris installs its udev rules and modules-load configuration as package files:
  /usr/lib/udev/rules.d/60-polaris.rules
  /usr/lib/modules-load.d/60-polaris.conf

pacman owns both, applies them via the systemd udev-reload hook, and removes them
on uninstall. Virtual input and controller support works after the next reboot
with no further steps.

To use it without rebooting first, load the modules once:
  sudo modprobe uinput uhid

Only DRM/KMS capture still needs an explicit privileged step, repeated after every
update because an update replaces the binary that held the capability:
  sudo -H polaris --setup-host --enable-kms

For crash debugging, install polaris-debug from the same release as Polaris.
Find the crash, then open its matching symbols in a debugger:
  coredumpctl list
  coredumpctl debug PID
Replace PID with the Polaris crash's process ID from the list.

Optional background autostart:
  systemctl --user enable --now polaris
EOF
}

print_upgrade_hint() {
  if [ -f /etc/udev/rules.d/60-polaris.rules ]; then
    cat <<'EOF'

An older Polaris left /etc/udev/rules.d/60-polaris.rules behind. /etc overrides the
packaged rules, so run host setup once to retire it:
  sudo -H polaris --setup-host
EOF
  fi
}

# The Spaces helper is the only thing that can remove the SELinux policies it installed, and it
# ships inside this package, so once the package is gone those policies cannot be removed by
# anything. pacman calls this only on removal, never on an upgrade, which is exactly right: an
# upgrade is about to put the same helper back.
remove_spaces_security() {
  local spaces_setup=/usr/bin/polaris-spaces-setup

  if [ ! -x "$spaces_setup" ]; then
    return 0
  fi

  echo "Removing the Spaces security setup while its helper is still installed."
  if "$spaces_setup" remove; then
    echo "Spaces security setup removed."
  else
    cat <<'EOF'
The Spaces helper refused to remove its security setup, and nothing else can remove it once this
package is gone. Reinstall Polaris, run the helper, then remove again:
  sudo -H /usr/bin/polaris-spaces-setup remove
Prepare Spaces security support in the Spaces guide explains each refusal.
EOF
  fi
}

print_removal_leftovers() {
  cat <<'EOF'
Polaris settings, paired devices and library stay in ~/.config/polaris, untouched.
A source build under /usr/local, Docker volumes holding each Space's games, and the
polaris-kms group are also left behind. The uninstall guide lists all of them.
EOF
}

post_install() {
  print_host_setup_hint
}

post_upgrade() {
  print_host_setup_hint
  print_upgrade_hint
}

pre_remove() {
  remove_spaces_security
  print_removal_leftovers
}
