print_steamos_setup_hint() {
  printf '%s\n' \
    'Polaris for SteamOS 3.8 runs in Desktop Mode and streams the Game Mode screen.' \
    'To keep it running across a switch to Game Mode, start it at boot once:' \
    '  sudo -H polaris --setup-host --enable-headless-boot' \
    'SteamOS updates can remove packages installed on the root filesystem.' \
    '' \
    'The udev rules and modules-load configuration are package files:' \
    '  /usr/lib/udev/rules.d/60-polaris.rules' \
    '  /usr/lib/modules-load.d/60-polaris.conf' \
    'Virtual input works after the next reboot with no further steps. To use it' \
    'without rebooting first, load the modules once:' \
    '  sudo modprobe uinput uhid' \
    '' \
    'Only DRM/KMS capture still needs a privileged step, repeated after every update:' \
    '  sudo -H polaris --setup-host --enable-kms' \
    '' \
    'Optional user-service autostart:' \
    '  systemctl --user enable --now polaris'
}

# The Spaces helper is the only thing that can remove the SELinux policies it installed, and it
# ships inside this package, so once the package is gone those policies cannot be removed by
# anything. pacman calls this only on removal, never on an upgrade.
remove_spaces_security() {
  local spaces_setup=/usr/bin/polaris-spaces-setup

  if [ ! -x "$spaces_setup" ]; then
    return 0
  fi

  printf '%s\n' 'Removing the Spaces security setup while its helper is still installed.'
  if "$spaces_setup" remove; then
    printf '%s\n' 'Spaces security setup removed.'
  else
    printf '%s\n' \
      'The Spaces helper refused to remove its security setup, and nothing else can remove it' \
      'once this package is gone. Reinstall Polaris, run the helper, then remove again:' \
      '  sudo -H /usr/bin/polaris-spaces-setup remove' \
      'Prepare Spaces security support in the Spaces guide explains each refusal.'
  fi
}

print_removal_leftovers() {
  printf '%s\n' \
    'Polaris settings, paired devices and library stay in ~/.config/polaris, untouched.' \
    "A source build under /usr/local, Docker volumes holding each Space's games, and the" \
    'polaris-kms group are also left behind. The uninstall guide lists all of them.'
}

post_install() {
  print_steamos_setup_hint
}

post_upgrade() {
  print_steamos_setup_hint
}

pre_remove() {
  remove_spaces_security
  print_removal_leftovers
}
