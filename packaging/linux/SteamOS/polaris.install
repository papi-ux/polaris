print_steamos_setup_hint() {
  printf '%s\n' \
    'Polaris for SteamOS 3.8 is supported in Desktop Mode.' \
    'Steam Game Mode host operation is not yet certified.' \
    'SteamOS updates can remove packages installed on the root filesystem.' \
    '' \
    'The udev rules and modules-load configuration are package files:' \
    '  /usr/lib/udev/rules.d/60-polaris.rules' \
    '  /usr/lib/modules-load.d/60-polaris.conf' \
    'Virtual input works after the next reboot with no further steps. To use it' \
    'without rebooting first, load the modules once:' \
    '  sudo modprobe uinput uhid' \
    '' \
    'Only DRM/KMS capture still needs a privileged step:' \
    '  sudo -H polaris --setup-host --enable-kms' \
    '' \
    'Optional user-service autostart:' \
    '  systemctl --user enable --now polaris'
}

post_install() {
  print_steamos_setup_hint
}

post_upgrade() {
  print_steamos_setup_hint
}
